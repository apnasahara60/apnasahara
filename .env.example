# ==========================================
# APNASAHARA ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Project URL & Anonymous Public Key
# Optional for demo mode: If left empty, the application automatically runs
# with a local-first persistent data engine in LocalStorage with full CRUD and event listeners.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Metadata
VITE_APP_NAME=ApnaSahara
VITE_APP_VERSION=1.0.0
